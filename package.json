{
  "name": "ll2pp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply ll2pp --remote && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "jose": "^6.2.18",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "baseline-browser-mapping": "^2.11.35",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "wrangler": "^4.167.0"
  }
}
